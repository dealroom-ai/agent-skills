# Dealroom API credentials. Copy to .env, fill in the required values, then use the
# dealroom client snippet (dealroom.py / dealroom.ts) - it mints and refreshes
# access tokens for you. No token is stored here.
#
# DO NOT COMMIT THIS FILE. Add .env to .gitignore.

# Generated at https://app-next.beta.dealroom.co/settings/api
# Pick "Programmatic (M2M)". Both client_id and client_secret are shown once.
DEALROOM_CLIENT_ID="paste-your-client-id-here"
DEALROOM_CLIENT_SECRET="paste-your-client-secret-here"

# Optional: identifies your app in Dealroom's logs for server-side calls.
# Include app name + version + contact when you set it.
# DEALROOM_USER_AGENT="my-app/0.1 (you@example.com)"

# Optional overrides. Defaults target beta; set these only for another environment.
# DEALROOM_API_BASE="https://api-next.beta.dealroom.co"
# DEALROOM_AUTH_URL="https://accounts.beta.dealroom.co/oauth/token"
# DEALROOM_AUDIENCE="https://api-next.beta.dealroom.co"
